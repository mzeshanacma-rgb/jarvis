<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light, professional window theme (matches the Compose theme). -->
    <style name="Theme.Jarvis" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/jarvis_bg</item>
        <item name="android:colorPrimary">@color/jarvis_primary</item>
        <item name="android:colorAccent">@color/jarvis_primary</item>
        <item name="android:statusBarColor">@color/jarvis_bg</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Jarvis.Confirm" parent="Theme.Jarvis">
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
